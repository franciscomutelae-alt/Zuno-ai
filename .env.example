# GEMINI_API_KEY: Server-side API key for ZUNO AI generative text and image engines.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Official ZUNO AI public domain URLs (production deployment target)
APP_URL="https://zunoai.com"
PUBLIC_APP_URL="https://zunoai.com"
VITE_PUBLIC_APP_URL="https://zunoai.com"

# Optional canonical host redirect in production (redirects www.zunoai.com -> zunoai.com)
CANONICAL_HOST="zunoai.com"
